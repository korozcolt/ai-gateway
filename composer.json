{
    "name": "korbytes/ai-gateway",
    "description": "Korbytes AI gateway for Laravel: DB-backed AI provider connections with encrypted tokens, swappable drivers (OpenAI-compatible incl. OpenRouter/NVIDIA Build, Gemini), usage metering and multimodal requests.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/encryption": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "laravel/pint": "^1.27",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Korbytes\\AiGateway\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Korbytes\\AiGateway\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Korbytes\\AiGateway\\AiGatewayServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
