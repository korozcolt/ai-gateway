{
    "name": "korozcolt/ai-gateway",
    "description": "A multi-provider AI gateway for Laravel: provider connections and encrypted API tokens stored in the database, OpenAI-compatible (OpenRouter, NVIDIA Build, OpenAI, Azure, Mistral, Groq), Gemini and fake drivers, multimodal requests and usage metering.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/queue": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/encryption": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "laravel/pint": "^1.27",
        "larastan/larastan": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Korbytes\\AiGateway\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Korbytes\\AiGateway\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Korbytes\\AiGateway\\AiGatewayServiceProvider"
            ],
            "aliases": {
                "AiGateway": "Korbytes\\AiGateway\\Facades\\AiGateway"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/korozcolt/ai-gateway",
    "keywords": [
        "laravel",
        "ai",
        "llm",
        "openrouter",
        "openai",
        "gemini",
        "nvidia",
        "gateway",
        "multimodal",
        "ocr",
        "structured-output"
    ],
    "authors": [
        {
            "name": "Korozcolt",
            "email": "dev@korozcolt.com",
            "homepage": "https://github.com/korozcolt"
        }
    ],
    "support": {
        "issues": "https://github.com/korozcolt/ai-gateway/issues",
        "source": "https://github.com/korozcolt/ai-gateway"
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "analyse": "phpstan analyse"
    }
}
